print()

for symbol in WATCHLIST:
    signal, price, sma20, sma50 = get_signal(symbol)

    if price is None:
        print(f"{symbol}: NO DATA")
        continue

    print(
        f"{symbol:5} {signal:4} | "
        f"Price={price:.2f} "
        f"SMA20={sma20:.2f} "
        f"SMA50={sma50:.2f}"
    )

    if signal != "BUY":
        continue

    if already_owned(symbol):
        print("  -> already owned")
        continue

    if has_open_order(symbol):
        print("  -> open order already exists")
        continue

    print("\nAI Analysis:")
    print("------------")

    try:
        analysis = ai_analyze(symbol, price, sma20, sma50)
        print(analysis)
    except Exception as e:
        print(f"AI analysis failed: {e}")
        log_recommendation(symbol, price, sma20, sma50, signal, f"ERROR: {e}", "AI_FAILED", "")
        continue

    print()

    telegram_message = f"""
💎 Trader Joe Buy Signal 🚀

Ticker: {symbol}
Price: ${price:.2f}
SMA20: {sma20:.2f}
SMA50: {sma50:.2f}

{analysis}

Reply locally:
y = buy ${DEFAULT_BUY_AMOUNT}
<number> = custom amount
n = skip
"""

    send_telegram(telegram_message)

    approval_id = create_pending_approval(
    symbol,
    price
)

telegram_message = f"""
💎 Trader Joe Buy Signal 🚀

Approval ID: {approval_id}

Ticker: {symbol}
Price: ${price:.2f}

{analysis}

Reply:

{approval_id} y
{approval_id} 1000
{approval_id} n
"""

send_telegram(telegram_message)

print(
    f"  -> queued approval #{approval_id}"
)
    should_buy, buy_amount = parse_buy_amount(answer)

    if not should_buy:
        print("  -> skipped")
        log_recommendation(symbol, price, sma20, sma50, signal, analysis, "SKIPPED", "")
        continue

    allowed, reason = risk_check(symbol, buy_amount)

    if not allowed:
        print(f"  -> BLOCKED: {reason}")
        send_telegram(f"⚠️ Trader Joe blocked {symbol}: {reason}")
        log_recommendation(symbol, price, sma20, sma50, signal, analysis, "BLOCKED", reason)
        continue

    order = place_paper_buy(symbol, buy_amount)

    print(f"  -> ORDER SUBMITTED ({order.status})")

    send_telegram(f"""
💰 Trader Joe Order Submitted

Ticker: {symbol}
Amount: ${buy_amount:,.2f}
Status: {order.status}

Joe has pressed the big shiny button responsibly.
""")

    log_recommendation(symbol, price, sma20, sma50, signal, analysis, f"APPROVED ${buy_amount}", str(order.status))

print("\nDone.\n")
