# Trader Joe — example environment file
#
# Copy the section you need into the matching `.env.<context>` file:
#
#   .env.paper       -> normal paper trading (trader.py)
#   .env.crypto      -> crypto paper / testing (crypto_trader.py)
#   .env.research    -> historical validation, replay, Backtest Lab,
#                       Champion/Challenger research
#                       (strategy/research_account.py)
#   .env.production  -> future live trading (real money)
#                       LEAVE EMPTY UNTIL EXPLICIT PRODUCTION APPROVAL
#
# All four `.env.*` files are gitignored. `.env.example` is the ONLY
# tracked template — it must contain placeholder values only.
#
# See docs/agent/env-isolation.md for isolation rules and safeguards.

# =========================================================================
# .env.paper — normal paper trading (equities)
# =========================================================================
# Loaded by: trader.py
# Alpaca account: the normal paper account.
# trader.py hardcodes PAPER = True and passes paper=PAPER to TradingClient.
# Do NOT reuse these credentials in the crypto, research, or production
# contexts.

ALPACA_API_KEY=replace-with-paper-api-key
ALPACA_SECRET_KEY=replace-with-paper-secret-key
ALPACA_ENDPOINT=https://paper-api.alpaca.markets

OPENAI_API_KEY=replace-with-openai-api-key
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Paper-context AI model. Overrides trader.py's legacy default when set.
# Leave empty to preserve the current default. See strategy/model_config.py.
PAPER_AI_MODEL=

# =========================================================================
# .env.crypto — crypto paper trading / crypto testing
# =========================================================================
# Loaded by: crypto_trader.py
# Alpaca account: the dedicated crypto testing paper account.
# crypto_trader.py hardcodes PAPER = True.
# Do NOT reuse these credentials in the paper, research, or production
# contexts.

CRYPTO_ALPACA_API_KEY=replace-with-crypto-paper-api-key
CRYPTO_ALPACA_SECRET_KEY=replace-with-crypto-paper-secret-key

# Crypto-context AI model. Overrides crypto_trader.py's legacy default when set.
# Leave empty to preserve the current default. See strategy/model_config.py.
CRYPTO_AI_MODEL=

# =========================================================================
# .env.research — historical validation / replay / Backtest Lab
# =========================================================================
# Loaded by: strategy/research_account.py (ResearchAccountClient)
# Alpaca account: the dedicated Research paper account — distinct
# from the normal paper account.
#
# Hard rules (enforced by strategy/research_account.py):
#   - Read-only client: only fetch_bars, list_calendar,
#     paper_account_info are exposed.
#   - Refuses to fall back to ALPACA_* / APCA_* env values.
#   - Not imported by any Phase 1-4 module, live runner, scheduler,
#     Telegram approval path, CLI, or plugin.
#   - Credentials never persisted to disk by the module.

RESEARCH_ALPACA_API_KEY=replace-with-research-paper-api-key
RESEARCH_ALPACA_SECRET_KEY=replace-with-research-paper-secret-key
RESEARCH_ALPACA_ENDPOINT=https://paper-api.alpaca.markets

# Research-context LLM endpoint.
#
# Default policy: loopback ONLY (127.0.0.1 / localhost / ::1).
# strategy/research_analyst.py refuses non-loopback endpoints unless
# BOTH RESEARCH_LLM_ALLOW_REMOTE=true AND the host appears in
# RESEARCH_LLM_ALLOWED_HOSTS.  Public IPs and cloud provider
# domains are refused at all times, regardless of opt-in.
#
# Safe local defaults:
#   http://127.0.0.1:8080   (llama.cpp / llama-swap default)
#   http://127.0.0.1:11434  (Ollama default)
#   http://localhost:1234   (LM Studio default)
RESEARCH_LLM_ENDPOINT=http://127.0.0.1:8080

# Opt-in: allow a NON-loopback endpoint for a local-LAN LLM box.
# Must be `true` (also accepted: `1`, `yes`, `on`) to enable.  Any
# other value keeps the loopback-only default.  Cloud endpoints
# remain refused regardless of this setting.
RESEARCH_LLM_ALLOW_REMOTE=false

# Comma-separated allowlist of trusted LAN hosts.  Consulted only
# when RESEARCH_LLM_ALLOW_REMOTE=true.  Each entry must be a
# private LAN IP (RFC1918: 10/8, 172.16/12, 192.168/16; or IPv6
# ULA fc00::/7) or a trusted internal hostname.  Public IPs are
# refused even when listed here.
#
# Example — a llama.cpp box on the local network:
#   RESEARCH_LLM_ENDPOINT=http://10.100.0.13:8080
#   RESEARCH_LLM_ALLOW_REMOTE=true
#   RESEARCH_LLM_ALLOWED_HOSTS=10.100.0.13
RESEARCH_LLM_ALLOWED_HOSTS=

# Research-context LLM API style — provider protocol the client
# uses to talk to the local inference server.  Chosen only from
# this env var (no auto-detection).  Supported values:
#   openai  — GET /v1/models, POST /v1/chat/completions
#             (llama.cpp, llama-swap, LM Studio, Hermes Gateway,
#              vLLM, and other OpenAI-compat servers)
#   ollama  — GET /api/tags, POST /api/chat
#             (Ollama)
RESEARCH_LLM_API_STYLE=openai

# Research-context AI model (used by the Research Analyst).
# Must be a locally-hosted model reachable at RESEARCH_LLM_ENDPOINT.
# Cloud model tokens (openai / anthropic / google / azure / aws /
# gemini / claude / chatgpt) are refused by the client.
RESEARCH_AI_MODEL=

# =========================================================================
# .env.production — future live trading (real money)
# =========================================================================
# NOT LOADED BY ANY CURRENT MODULE.
#
# Production means real money. Real orders, real fills, real
# capital at risk.
#
# `.env.production` MUST REMAIN EMPTY until an explicit
# ApprovalRecord (see strategy/promotion_gates.py) authorises live
# trading. The ApprovalRecord must name approver, dated approval,
# flag scope, monitoring dashboard, and rollback plan.
#
# See ROADMAP.md "v1.0 Production Readiness" for the full gate.
#
# When (and only when) production is approved, populate the block
# below with the approved credentials AND flip PAPER = False in the
# same commit AND cite the approving ApprovalRecord id in the PR.
#
# ALPACA_LIVE_API_KEY=
# ALPACA_LIVE_SECRET_KEY=
# ALPACA_LIVE_ENDPOINT=https://api.alpaca.markets
# HERMES_PRODUCTION_APPROVAL_ID=
# PRODUCTION_AI_MODEL=
