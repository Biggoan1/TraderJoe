#!/usr/bin/env bash
# scripts/traderjoe-crypto-paper-daemon — one tick of the crypto
# 24/7 paper daemon.  Plan-only by default; auto-execute requires
# PAPER_AUTO_EXECUTE_CRYPTO=true in .env.crypto AND
# --execute-paper-orders.  Never touches the equity paper account.
#
# Usage (plan-only):
#   ./scripts/traderjoe-crypto-paper-daemon --symbols BTC/USD ETH/USD SOL/USD
#
# Usage (auto-execute):
#   ./scripts/traderjoe-crypto-paper-daemon --symbols BTC/USD ETH/USD SOL/USD \
#     --execute-paper-orders

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

if [ "${HERMES_CONTEXT:-}" = "production" ]; then
  echo "ERROR: refusing to run traderjoe-crypto-paper-daemon with HERMES_CONTEXT=production" >&2
  exit 1
fi

case "${PAPER:-}" in
  False|false|0|no|off|No|Off|NO|OFF)
    echo "ERROR: refusing to run traderjoe-crypto-paper-daemon with PAPER=${PAPER}" >&2
    exit 1
    ;;
esac

export HERMES_CONTEXT="${HERMES_CONTEXT:-crypto}"

cd "$REPO_ROOT"

if [ -x "$REPO_ROOT/.venv/bin/python" ]; then
  PYTHON="$REPO_ROOT/.venv/bin/python"
else
  PYTHON="python"
fi

exec "$PYTHON" -m strategy.crypto_paper_daemon_main "$@"
